{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "appeseguibileprova-rust",
  "version": "0.1.0",
  "identifier": "com.cosmi.appeseguibileprova-rust",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "appeseguibileprova-rust",
        "width": 800,
        "height": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUxMzAyQUZGQTBBQjRGNEMKUldSTVQ2dWcveW93NFNlSkg1YURIaHhvSnBJQWNvTUgyb2lyVlJReDAyNlVhVGhuZFdnemZETjQK",
      "endpoints": [
        "https://raw.githubusercontent.com/CosminSebastian2025/appeseguibileprova/main/latest.json"
      ],
      "windows": {
        "installMode": "basicUi"
      }
    }
  }
}
